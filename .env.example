# BALMZ AI server-side environment template.
# Keep real values only in Render's encrypted environment settings.
# Never use NEXT_PUBLIC_ prefixes for credentials.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/balmz_ai?sslmode=require"
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
BETTER_AUTH_URL="https://balmz-ai.onrender.com"
BETTER_AUTH_TRUSTED_ORIGINS="https://balmz-ai.onrender.com"
APP_BASE_URL="https://balmz-ai.onrender.com"

# Transactional email. Verify the domain/sender with Resend before enabling.
RESEND_API_KEY=""
EMAIL_FROM="BALMZ AI <no-reply@your-verified-domain.example>"

# AI providers. Any configured key can be used by Super Admin integrations
# without entering it again in the browser. A provider must still pass its
# own model-list/test request before it appears as a connected model.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GOOGLE_AI_API_KEY=""
GOOGLE_API_KEY=""
XAI_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
TOGETHER_API_KEY=""
FIREWORKS_API_KEY=""

# Service integrations. The connector hub can test and save these server
# credentials directly; no browser key entry is needed when they exist here.
CHARTGPT_API_KEY=""
COINGECKO_DEMO_API_KEY=""
COINGECKO_PRO_API_KEY=""
GITHUB_TOKEN=""
RENDER_API_KEY=""
NEON_API_KEY=""
NOTION_API_KEY=""
NOTES_AI_API_KEY=""
NOTES_AI_BASE_URL=""
NOTES_AI_MODEL=""

# Paystack: add only the matching mode secrets after merchant setup.
# Keep both Demo and Live modes disabled until verified end-to-end.
PAYSTACK_MODE=""
PAYSTACK_TEST_SECRET_KEY=""
PAYSTACK_LIVE_SECRET_KEY=""
PAYSTACK_TEST_WEBHOOK_SECRET=""
PAYSTACK_LIVE_WEBHOOK_SECRET=""
# Legacy compatibility aliases, only when the mode is set correctly:
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Private Cloudflare R2 storage.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
