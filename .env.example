# Neon PostgreSQL URL (server-side only; require TLS in production).
# Use the restricted balmz_ai_app role for application runtime access.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/balmz_ai?sslmode=require"

# Unique Better Auth secret (at least 32 random characters).
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Canonical BALMZ AI HTTPS origin.
BETTER_AUTH_URL="https://balmz-ai.onrender.com"
BETTER_AUTH_TRUSTED_ORIGINS="https://balmz-ai.onrender.com"

# Transactional email (Resend). Configure BOTH values only after verifying
# the sender/domain in Resend. When enabled, new accounts require email
# verification and password-reset links are delivered by this sender.
RESEND_API_KEY=""
EMAIL_FROM="BALMZ AI <no-reply@your-verified-domain.example>"

# Paystack variables are intentionally not enabled by this template.
# Configure test-mode credentials only through Render secure environment
# settings after reviewing docs/PAYSTACK_BILLING_RUNBOOK.md.
