# Neon PostgreSQL URL (server-side only; require TLS in production).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/balmz_ai?sslmode=require"

# Generate a unique random secret with at least 32 characters.
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# BALMZ AI public application origin.
BETTER_AUTH_URL="https://balmz-ai.onrender.com"
BETTER_AUTH_TRUSTED_ORIGINS="https://balmz-ai.onrender.com"

# OpenAI provider key for the authenticated, subscription-metered client workplace.
# Keep this key in Render server environment only; never use NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=""
